# Runtime data and local configuration
var/
.env
# The local stmt store: git keeps its rules as store/rules.csv (rule deploy.rules.store).
store/*.sqlite
store/*.sqlite-*

# Playwright evidence: screenshots and failure traces (rule ui.e2e.evidence)
e2e-evidence/
_tmp/video-classification-1.0.0.zip
.claude/
