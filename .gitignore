# Python
__pycache__/
*.py[cod]
.venv/
dist/
# Only the top-level build output: vendored libraries keep their own build/ folders.
/build/
*.egg-info/

# Tests and coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
