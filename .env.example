# Copy to .env. The container runs as this user so it can write ./var.
SREDITOR_UID=1000
SREDITOR_GID=1000
# The address you open in the browser; forms from any other origin are refused.
SREDITOR_PUBLIC_URL=http://localhost:8000
# Development only: log emails with their token links intact (false in production).
SREDITOR_MAIL_LOG_TOKENS=false
# Email delivery through SMTP2GO. Leave the key empty to only log emails.
# The sender must be a sender or domain verified in your SMTP2GO account.
SREDITOR_SMTP2GO_API_KEY=
SREDITOR_MAIL_SENDER="sreditor <noreply@example.com>"
# Voice-over generation with ElevenLabs. Leave empty to hide it; each new take spends credits.
SREDITOR_ELEVENLABS_API_KEY=
# `sreditor doctor` checks this file; `--fix` fills it in. It remembers the environment
# (development or production) and the public hostname served through the Cloudflare tunnel.
SREDITOR_ENVIRONMENT=development
SREDITOR_TUNNEL_HOSTNAME=
# Internet access through a Cloudflare Tunnel (optional). `sreditor doctor --fix --hostname H`
# creates it when CLOUDFLARE_API_TOKEN is exported in the shell (never put that token here).
# By hand: create the tunnel in Cloudflare Zero Trust > Networks > Tunnels, route its public
# hostname to http://sreditor:8000, paste its token here, enable the profile, and set
# SREDITOR_PUBLIC_URL=https://<that hostname>.
# COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=
# Observability (rule deploy.observability): Prometheus, Loki, Alloy and Grafana. Enable the
# profile, alone or beside the tunnel (COMPOSE_PROFILES=tunnel,observability), then open
# Grafana at http://127.0.0.1:3000 as admin. Without a password Grafana falls back to admin/admin.
# COMPOSE_PROFILES=observability
GRAFANA_ADMIN_PASSWORD=
